{
  "$schema": "vidkit.tokens/1",
  "name": "neo-brutal",
  "notes": "Primary direction: neo-brutalism. Palette values are hand-set to the named colours because the reference board image was not attached; run `python -m design.sample_palette design/reference/<board>.png` to re-sample them (keeps names, replaces hex, sets sampled=true).",
  "palette": {
    "sampled": false,
    "lime":       "#CDF545",
    "orange":     "#FF4F1F",
    "cobalt":     "#2342F5",
    "paper":      "#F3EFE4",
    "ink":        "#121212",
    "ink-soft":   "#4E4B45",
    "paper-deep": "#E2DCCB",
    "white":      "#FFFFFF"
  },
  "pairs": {
    "comment": "Allowed text/background pairs with their WCAG contrast. Text never sits on a pair below 4.5 unless it is display size (>= 3.0).",
    "ink-on-paper":    { "fg": "ink",   "bg": "paper",  "min": 4.5 },
    "ink-on-lime":     { "fg": "ink",   "bg": "lime",   "min": 4.5 },
    "ink-on-orange":   { "fg": "ink",   "bg": "orange", "min": 4.5 },
    "paper-on-ink":    { "fg": "paper", "bg": "ink",    "min": 4.5 },
    "paper-on-cobalt": { "fg": "paper", "bg": "cobalt", "min": 4.5 },
    "lime-on-ink":     { "fg": "lime",  "bg": "ink",    "min": 4.5 },
    "lime-on-cobalt":  { "fg": "lime",  "bg": "cobalt", "min": 4.5 }
  },
  "fonts": {
    "display": { "family": "Archivo Black", "file": "assets/fonts/archivo-black/ArchivoBlack-Regular.ttf", "weight": "400", "licence": "assets/fonts/archivo-black/OFL.txt" },
    "body":    { "family": "Archivo", "file": "assets/fonts/archivo/Archivo-Variable.ttf", "weight": "100 900", "stretch": "62% 125%", "licence": "assets/fonts/archivo/OFL.txt" },
    "body-italic": { "family": "Archivo", "file": "assets/fonts/archivo/Archivo-Italic-Variable.ttf", "weight": "100 900", "style": "italic", "licence": "assets/fonts/archivo/OFL.txt" },
    "mono":    { "family": "Space Mono", "file": "assets/fonts/space-mono/SpaceMono-Regular.ttf", "weight": "400", "licence": "assets/fonts/space-mono/OFL.txt" },
    "mono-bold": { "family": "Space Mono", "file": "assets/fonts/space-mono/SpaceMono-Bold.ttf", "weight": "700", "licence": "assets/fonts/space-mono/OFL.txt" },
    "code":    { "family": "JetBrains Mono", "file": "assets/fonts/jetbrains-mono/JetBrainsMono-Variable.ttf", "weight": "100 800", "licence": "assets/fonts/jetbrains-mono/OFL.txt" }
  },
  "type": {
    "comment": "Video ramp in px at 1080p frame height; scales with frame height. Max 3 sizes per scene plus hero.",
    "hero":    { "font": "display", "size": 216, "leading": 0.9,  "tracking": -0.02, "weight": 400 },
    "display": { "font": "display", "size": 132, "leading": 0.94, "tracking": -0.015, "weight": 400 },
    "h1":      { "font": "display", "size": 88,  "leading": 1.0,  "tracking": -0.01, "weight": 400 },
    "h2":      { "font": "body",    "size": 56,  "leading": 1.08, "tracking": -0.01, "weight": 700 },
    "body":    { "font": "body",    "size": 34,  "leading": 1.32, "tracking": 0,     "weight": 450 },
    "label":   { "font": "mono",    "size": 22,  "leading": 1.2,  "tracking": 0.06,  "weight": 400 },
    "micro":   { "font": "mono",    "size": 18,  "leading": 1.2,  "tracking": 0.06,  "weight": 400 }
  },
  "ui_type": {
    "comment": "Editor chrome, CSS px.",
    "title": { "font": "display", "size": 18 },
    "panel": { "font": "display", "size": 13 },
    "body":  { "font": "body",    "size": 13, "weight": 500 },
    "label": { "font": "mono",    "size": 11 },
    "micro": { "font": "mono",    "size": 10 }
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192],
  "baseline": 8,
  "radius": 0,
  "border": { "ui": 3, "video": 6 },
  "shadow": {
    "comment": "Hard offset shadows, solid ink, no blur.",
    "ui":    { "x": 6,  "y": 6,  "color": "ink" },
    "ui-lg": { "x": 8,  "y": 8,  "color": "ink" },
    "video": { "x": 14, "y": 14, "color": "ink" },
    "video-lg": { "x": 22, "y": 22, "color": "ink" }
  },
  "grid": {
    "landscape": { "columns": 12, "margin": 96, "gutter": 24, "baseline": 8, "safe": 0.05 },
    "portrait":  { "columns": 6,  "margin": 64, "gutter": 24, "baseline": 8, "safe": 0.05 },
    "square":    { "columns": 8,  "margin": 72, "gutter": 24, "baseline": 8, "safe": 0.05 }
  },
  "motion": {
    "comment": "Damped springs per property. k = stiffness, c = damping, m = mass. Only these presets may be used by scenes.",
    "snappy": { "position": { "k": 380, "c": 26 }, "scale": { "k": 420, "c": 32 }, "rotation": { "k": 320, "c": 24 }, "opacity": { "k": 520, "c": 46 } },
    "slam":   { "position": { "k": 900, "c": 50, "m": 2 }, "scale": { "k": 640, "c": 40 }, "rotation": { "k": 520, "c": 34 }, "opacity": { "k": 900, "c": 62 } },
    "soft":   { "position": { "k": 120, "c": 21 }, "scale": { "k": 140, "c": 24 }, "rotation": { "k": 120, "c": 21 }, "opacity": { "k": 160, "c": 26 } },
    "quick":  { "position": { "k": 600, "c": 49 }, "scale": { "k": 600, "c": 49 }, "rotation": { "k": 600, "c": 49 }, "opacity": { "k": 700, "c": 53 } },
    "wobble": { "position": { "k": 260, "c": 12 }, "scale": { "k": 300, "c": 14 }, "rotation": { "k": 260, "c": 9 },  "opacity": { "k": 520, "c": 46 } },
    "stagger": { "char": 0.022, "word": 0.055, "line": 0.11, "item": 0.133 },
    "exit": { "length": 0.4 }
  },
  "ui": {
    "comment": "Editor chrome roles mapped to palette names.",
    "bg": "paper", "panel": "paper", "panel-alt": "paper-deep", "ink": "ink", "muted": "ink-soft",
    "accent": "lime", "danger": "orange", "focus": "cobalt", "selection": "cobalt",
    "track-visual": "lime", "track-text": "white", "track-audio": "cobalt", "track-scene": "orange"
  }
}

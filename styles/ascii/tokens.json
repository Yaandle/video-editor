{
  "label": "ASCII art",
  "notes": "Characters from JetBrains Mono (OFL, already in assets/fonts) registered under its own family name so the atlas never depends on page CSS.",
  "font": {
    "family": "VK ASCII Mono",
    "file": "assets/fonts/jetbrains-mono/JetBrainsMono-Variable.ttf"
  },
  "palette": {
    "paper": "#F3EFE4",
    "ink": "#121212",
    "orange": "#FF4F1F",
    "cobalt": "#2342F5",
    "lime": "#CDF545"
  },
  "sets": {
    "letters": " .:-=+*#%@",
    "blocks": " ░▒▓█",
    "dots": " .·•●",
    "code": " .,;<{[#@"
  },
  "sfx": {
    "impact": "ascii.carriage",
    "pop": "ascii.key",
    "click": "ascii.key",
    "tick": "ascii.key",
    "whoosh": "ascii.chirp",
    "riser": "ascii.stream"
  },
  "music": "terminal",
  "cohesion": {
    "min": 0.9,
    "de": 16
  },
  "checks": [
    "temporal",
    "legibility"
  ],
  "demo": {
    "thumb_t": 3.4
  },
  "slop": {
    "gradient_allow": 0.0
  }
}

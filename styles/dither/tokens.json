{
  "label": "Dithering",
  "notes": "Ordered dither (Bayer 2/4/8 or blue noise) in 2-4 inks drawn from the neo-brutal palette. Error diffusion (Floyd-Steinberg) is offered for stills only: on moving content it shimmers.",
  "palette": {
    "ink": "#121212",
    "paper": "#F3EFE4",
    "orange": "#FF4F1F",
    "cobalt": "#2342F5",
    "lime": "#CDF545"
  },
  "inks": {
    "mono": ["ink", "paper"],
    "duo": ["cobalt", "paper"],
    "tri": ["ink", "orange", "paper"],
    "quad": ["ink", "cobalt", "orange", "paper"],
    "acid": ["ink", "lime"]
  },
  "sfx": {
    "impact": "dither.crunch",
    "pop": "dither.blip",
    "click": "dither.blip",
    "tick": "dither.blip",
    "whoosh": "dither.burst",
    "riser": "dither.sweep"
  },
  "music": "bitcrush",
  "cohesion": { "min": 0.97, "de": 8 },
  "checks": ["temporal", "legibility", "pixel"],
  "native": { "short": 360 },
  "demo": { "thumb_t": 5.0 },
  "slop": { "gradient_allow": 0.0 }
}

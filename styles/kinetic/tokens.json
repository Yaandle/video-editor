{
  "label": "Kinetic typography",
  "notes": "Variable-axis type that lands word by word on the beat. Uses the core Archivo variable font (wght 100-900, wdth 62-125) through continuous width instances.",
  "palette": {
    "paper": "#F3EFE4",
    "ink": "#121212",
    "orange": "#FF4F1F",
    "lime": "#CDF545",
    "cobalt": "#2342F5",
    "paper-deep": "#E2DCCB"
  },
  "type": {
    "family": "Archivo",
    "file": "assets/fonts/archivo/Archivo-Variable.ttf",
    "wght": [100, 900],
    "wdth": [62, 125],
    "rest": { "weight": 520, "width": 84 },
    "hit": { "weight": 880, "width": 114 },
    "emphasis": { "weight": 900, "width": 122 },
    "leading": 0.98,
    "tracking": -0.015
  },
  "springs": { "land": "slam", "axes": "snappy", "exit": "quick" },
  "sfx": {
    "impact": "kinetic.thud",
    "pop": "kinetic.click",
    "whoosh": "kinetic.swish",
    "tick": "kinetic.click",
    "click": "kinetic.click",
    "riser": "kinetic.riser"
  },
  "music": "pulse",
  "cohesion": { "min": 0.9, "de": 16 },
  "checks": ["legibility", "temporal"],
  "slop": { "gradient_allow": 0.02 }
}

{
  "label": "Sketch notebook",
  "notes": "Hand-drawn lab-book page after the ESP32 sensor sheets, with formal type: The Seasons Bold (tracking -0.036 em) for headings, Gotham Bold for kickers and Gotham Book for body. Licensed fonts load from styles/sketch/fonts/ (git-ignored) when present; otherwise the stand-ins load. Each role loads its \"source\"; to switch to the licensed face, copy it in and set \"source\" to the \"licensed\" path.",
  "palette": {
    "paper": "#F6F3EB",
    "fleck": "#8A7F6A",
    "ink": "#2A2A2A",
    "faint": "#6B6B6B",
    "rule": "#3C3C3C",
    "edge": "#8C8C8C",
    "red": "#D8433A",
    "green": "#2E7D32",
    "orange": "#E07A1F",
    "highlight": "#FFD84A",
    "hole": "#CFC8B8",
    "wire": "#1E1E1E",
    "wireLight": "#6A6A6A",
    "code": "#2B2E34",
    "codeInk": "#E8E3D6",
    "codeComment": "#9CC28A",
    "white": "#FFFFFF",
    "margin": "#EFEBE1",
    "blue": "#1D4FB5"
  },
  "pen": {
    "text": 2300,
    "line": 3400
  },
  "sfx": {
    "impact": "sketch.tick",
    "pop": "sketch.tick",
    "click": "sketch.tick",
    "tick": "sketch.tick",
    "whoosh": "sketch.scratch",
    "riser": "sketch.rule"
  },
  "music": "lofi",
  "checks": [
    "temporal",
    "legibility"
  ],
  "demo": {
    "thumb_t": 13
  },
  "slop": {
    "gradient_allow": 0.0
  },
  "type": {
    "display": {
      "family": "VK Sketch Display",
      "fallback": "Georgia, serif",
      "tracking": -0.036,
      "source": "local(\"Georgia Bold\")",
      "licensed": "styles/sketch/fonts/TheSeasons-Bold.otf"
    },
    "sub": {
      "family": "VK Sketch Sub",
      "fallback": "sans-serif",
      "desc": {
        "weight": "100 900"
      },
      "source": "assets/fonts/jost/Jost-Variable.ttf",
      "licensed": "styles/sketch/fonts/Gotham-Bold.otf"
    },
    "body": {
      "family": "VK Sketch Body",
      "fallback": "sans-serif",
      "desc": {
        "weight": "100 900"
      },
      "source": "assets/fonts/jost/Jost-Variable.ttf",
      "licensed": "styles/sketch/fonts/Gotham-Book.otf"
    },
    "hand": {
      "family": "VK Sketch Hand",
      "fallback": "\"Segoe Print\", sans-serif",
      "source": "styles/sketch/fonts/Inkfree.ttf",
      "licensed": "styles/sketch/fonts/PatrickHand-Regular.ttf"
    },
    "gotham": {
      "family": "VK Sketch Gotham",
      "fallback": "sans-serif",
      "desc": {
        "weight": "100 900"
      },
      "source": "styles/sketch/fonts/Montserrat-wght.ttf",
      "licensed": "styles/sketch/fonts/Gotham-Bold.otf"
    },
    "math": {
      "stack": "\"Cambria\", \"Cambria Math\", Georgia, serif"
    }
  }
}